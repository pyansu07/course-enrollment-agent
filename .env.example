# LLM — any OpenAI-compatible chat endpoint.
#
# The key variable is named OPENAI_API_KEY because that is what langchain-openai's
# ChatOpenAI reads. It does NOT have to hold an OpenAI key: point OPENAI_BASE_URL at
# any compatible provider and put that provider's key here.
#
# Default setup is Groq's free tier.
#
# The model MUST support json_schema structured output — the skill router, the
# enrollment draft extractor and both guardrails all use with_structured_output().
# Verified working on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b.
# The groq/compound* models do NOT support it and will 400.
OPENAI_API_KEY=gsk-your-groq-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
#
# To use OpenAI instead, drop OPENAI_BASE_URL entirely and set:
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# Embeddings — a local sentence-transformers model. No API key, no network calls.
# Downloaded once to the HuggingFace cache on first use (~90MB).
# IMPORTANT: the indexer and the app must use the SAME model, or the query vector
# will not match the stored vectors' dimensionality and retrieval will fail.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG / ChromaDB
# CHROMA_HOST and CHROMA_PORT are injected by docker-compose for the app container.
# To run the app or indexer OUTSIDE Docker, point these at the Chroma server
# (compose exposes it on host port 8001):
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_COLLECTION=courses
# RAG_TOP_K=3
